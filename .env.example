# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API.
#
# Leave both variables empty (or omit the file) to run in demo mode: every
# query in lib/species.ts, lib/tours.ts and lib/advisories.ts falls back to the
# seed rows committed in those files, so the portal works without a database.

#
# Newer Supabase projects label the browser key "publishable" (sb_publishable_…)
# instead of "anon". Either name works; the publishable key wins if both are set.
# Never put the service_role / secret key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects only:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (required for Vercel / multi-instance production persistence; never prefix NEXT_PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (FR-2.3, FR-6.3).
#
# Set MAILPIT_URL (for example http://localhost:8025 when running `docker compose up -d`)
# to capture all local portal emails inside Mailpit without calling external providers.
# Otherwise, Resend is used when RESEND_API_KEY and EMAIL_FROM are set, or emails log to
# the server console in demo mode.
MAILPIT_URL=
RESEND_API_KEY=
EMAIL_FROM=

# Where staff booking alerts land. Defaults to tours@naujanlake.gov.ph.
PARK_NOTIFICATION_EMAIL=

# Used for links inside emails (advisory notices, admin queue). Defaults to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Live Philippine payment gateway (GCash, Maya, QRPh, Online Banking).
# Leave empty to use the built-in interactive wallet authorization dialog
# alongside manual reference verification and Pay at Park Jetty.
PAYMONGO_SECRET_KEY=

# HMAC secret for signing HttpOnly session cookies (`nl_session`).
# Generate a 32+ byte random string for production deployments.
AUTH_SESSION_SECRET=

# Headless Ghost CMS integration (two-way content sync & webhooks).
# Leave empty to fall back to the built-in local store and seed catalogue.
GHOST_URL=
GHOST_CONTENT_API_KEY=
GHOST_ADMIN_API_KEY=
GHOST_WEBHOOK_SECRET=
