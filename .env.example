# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API.
#
# Leave both variables empty (or omit the file) to run in demo mode: every
# query in lib/species.ts, lib/tours.ts and lib/advisories.ts falls back to the
# seed rows committed in those files, so the portal works without a database.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Transactional email (FR-2.3, FR-6.3).
#
# Leave RESEND_API_KEY empty to run the mailer in demo mode: every message is
# printed to the server console instead of being sent, so the inquiry flow can
# be exercised without an account. EMAIL_FROM must be a verified Resend sender
# (e.g. "Naujan Lake <no-reply@naujanlake.gov.ph>") once the key is set.
RESEND_API_KEY=
EMAIL_FROM=

# Where staff booking alerts land. Defaults to tours@naujanlake.gov.ph.
PARK_NOTIFICATION_EMAIL=

# Used for links inside emails (advisory notices, admin queue). Defaults to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
